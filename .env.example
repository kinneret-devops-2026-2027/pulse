# Copy this file to .env and fill real values.  .env is in .gitignore.
# This example file IS committed - it documents which settings exist, without secrets.
APP_ENV=local
CHECK_TIMEOUT_SECONDS=3
SLOW_THRESHOLD_MS=800
# Team 4 will use this later (Discord/Telegram/Slack webhook). Keep it secret!
ALERT_WEBHOOK_URL=
